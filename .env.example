# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Values checked in docs/nebius-findings.md (T001)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
# No NVIDIA vision model is served on Token Factory. This model only DESCRIBES each frame;
# Nemotron judges it against the shot spec (docs/nebius-findings.md § The vision decision)
NEBIUS_MODEL_VISION=zai-org/GLM-5.3-Flash
# Per-call timeout and total attempts (retries on 429 / 5xx / network errors)
LLM_REQUEST_TIMEOUT_S=120
LLM_MAX_ATTEMPTS=3

# Image rendering (ComfyUI on a Nebius AI Cloud GPU)
COMFYUI_URL=http://localhost:8188

# Optional private style pack, kept outside this repo
PANELWISE_PRIVATE_STYLES=

# Database. Locally: the compose Postgres (docker-compose sets its own for the api container).
# Deployed (Railway): Supabase > Connect > Session pooler, port 5432. A postgresql:// URL is fine;
# the API adds the +asyncpg driver itself. docs/deploy.md step 1.
DATABASE_URL=postgresql+asyncpg://panelwise:panelwise@localhost:5432/panelwise

# Supabase, API side only (Railway). Used from T008 (Storage) and T009 (Auth); never in the web app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Web app (Vercel). API_URL is server-side only: the Railway domain, no trailing slash.
# The NEXT_PUBLIC_* pair reaches the browser: only ever the publishable key. Used from T009.
API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# docker-compose host ports; change any that are taken on your machine
# (and the port in DATABASE_URL above to match)
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# Spend caps
LLM_MONTHLY_TOKEN_CAP=
IMAGE_MONTHLY_GENERATION_CAP=
