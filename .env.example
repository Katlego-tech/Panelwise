# Copy to .env and fill in. Never commit .env.

# Nebius Token Factory (OpenAI-compatible). Values checked in docs/nebius-findings.md (T001)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
NEBIUS_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
# Every vision call: Nemotron 3.5 Super VL since T105 (2026-10-17; DeepSeek-V4.1-Flash before). It
# only DESCRIBES each frame; Nemotron judges it against the shot spec (docs/nebius-findings.md
# § The vision decision)
NEBIUS_MODEL_VISION=nvidia/Nemotron-3.5-Super-VL
# The vision model's thinking toggle (docs/design/vision-model.md, T105): off since the migration
# (docs/super-vl-migration.md); blank sends nothing.
NEBIUS_VISION_THINKING=false
# Per-call timeout, connect timeout and total attempts (retries on 429 / 5xx / network errors,
# waiting 2, 4, 8, 16 s; docs/design/llm.md, T075)
LLM_REQUEST_TIMEOUT_S=120
LLM_CONNECT_TIMEOUT_S=10
LLM_MAX_ATTEMPTS=5

# Image rendering: FLUX.2 [klein] 4B on fal.ai (docs/design/storyboard.md §3.5). FAL_KEY is a
# secret: never commit it. Unset, there is no renderer: "Try another render" and "Make the comic"
# answer 503 and an upload's job ends at planning. A drawing costs about $0.003-0.004 (a
# the-red-kite run at 3 attempts is about 49 drawings, $0.15-0.20).
FAL_KEY=
FAL_MODEL=fal-ai/flux-2/klein/4b
FAL_TIMEOUT_S=60
FAL_CONCURRENCY=2
# Drawings per frame before it is withheld, 1-3 (docs/design/verify.md §4, T071); every attempt
# is paid for, so this multiplies the spend
RENDER_MAX_ATTEMPTS=3
# The frame prompt's word budget (docs/design/storyboard.md §3.1): 55 for CLIP's 77 tokens (the
# name is from ComfyUI, T003, cut 2026-10-19; the fal renderer reads it)
COMFYUI_MAX_WORDS=55

# Optional private style pack: a directory of style TOMLs outside this repo (styles/README.md).
# Never set on the hosted demo
PANELWISE_PRIVATE_STYLES=

# Database. Locally: the compose Postgres (docker-compose sets its own for the api container).
# Deployed (Render): Supabase > Connect > Session pooler, port 5432. A postgresql:// URL is fine;
# the API adds the +asyncpg driver itself. docs/deploy.md step 1.
DATABASE_URL=postgresql+asyncpg://panelwise:panelwise@localhost:5432/panelwise

# Supabase, API side only (Render). Used from T008 (Storage) and T009 (Auth); never in the web app.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The private Storage bucket: panelwise-dev locally, panelwise on Render (the default)
SUPABASE_STORAGE_BUCKET=panelwise
# The largest PDF the API accepts, in bytes: below Vercel's ~4.5 MB function body limit (web.md §4.1)
UPLOAD_MAX_BYTES=4000000

# Web app (Vercel). API_URL is server-side only: the Render domain, no trailing slash.
# The NEXT_PUBLIC_* pair reaches the browser: only ever the publishable key. Used from T009.
API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# docker-compose host ports; change any that are taken on your machine
# (and the port in DATABASE_URL above to match)
POSTGRES_HOST_PORT=5432
API_HOST_PORT=8000
WEB_HOST_PORT=3000

# The hosted demo's limits (docs/design/limits.md, T069); empty = off, as locally.
# Hosted: a token budget under what's left of the Token Factory credit, 3 uploads, 15 pages.
LLM_MONTHLY_TOKEN_CAP=
UPLOADS_PER_DAY=
UPLOAD_MAX_PAGES=
# Drawings a month, counted from the audit log, storyboard and comic (limits.md §4, T030).
IMAGE_MONTHLY_GENERATION_CAP=
# Which failed hard checks withhold a frame (verify.md §3, T094): all (the default), empty for
# none, or a comma list. Hosted (render.yaml, T030): drawn_sex,no_character,split_panels.
AUDIT_WITHHOLD_CHECKS=all

# The judge seed only (python -m app.demo.seed, T069): local, never the hosted API's environment.
JUDGE_EMAIL=
JUDGE_PASSWORD=

# Local-only, for live checks against the Supabase project; never set on Render or Vercel.
# The Supabase database itself: Connect > Session pooler (port 5432), password filled in. The app
# never reads it (DATABASE_URL above stays local); from South Africa, run a health check against it
# with HEALTH_CHECK_TIMEOUT_S=10 (a cold connection to the EU takes 2-4 s).
SUPABASE_DB_URL=
# A dev user in the Supabase project for end-to-end checks (Authentication > Users)
PANELWISE_DEV_EMAIL=
PANELWISE_DEV_PASSWORD=
